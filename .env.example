# The F1 live dashboard already uses 8080. Use 8081 to run both production apps simultaneously.
# Set to 8080 when Gridlock is the only app on that host port.
FRONTEND_PORT=8081
# Set the externally visible HTTPS origin of Gridlock (recommended for all cloud deployments).
# Set this on HTTPS deployments; leave empty for local Vite development.
PUBLIC_ORIGIN=
# Only needed for a legacy global operator / database-wide backup account.
ADMIN_EMAIL=commissioner@example.com
ADMIN_BOOTSTRAP_KEY=REPLACE_WITH_RANDOM_SECRET_32_PLUS_CHARS
# Generate with: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
# Optional offsite encrypted snapshot target (rclone must be configured and installed).
BACKUP_RCLONE_REMOTE=
AUTO_SYNC_ON_STARTUP=true
