# REQUIRED: match the account used for your first commissioner registration.
ADMIN_EMAIL=commissioner@example.com
# Generate a long random value. Must be entered during the commissioner's signup.
ADMIN_BOOTSTRAP_KEY=REPLACE_WITH_RANDOM_SECRET_32_PLUS_CHARS
PORT=8080
HOST=0.0.0.0
DB_PATH=./data/pool.sqlite
BACKUP_DIR=./backups
# Generate: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=
# Optional; requires rclone installed/configured on your server:
# e.g. s3remote:my-f1-pool-backups  OR  gdrive:encrypted-f1-pool-backups
BACKUP_RCLONE_REMOTE=
AUTO_SYNC_ON_STARTUP=true
# Optional for separate-origin dev/proxy; same-origin Docker deployment doesn't need it.
ORIGIN=
