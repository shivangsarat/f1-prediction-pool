# The F1 live dashboard already uses 8080. Use 8081 to run both production apps simultaneously.
# Set to 8080 when Gridlock is the only app on that host port.
FRONTEND_PORT=8081
# Set the externally visible HTTPS origin of Gridlock (recommended for all cloud deployments).
# Set this on HTTPS deployments; leave empty for local Vite development.
PUBLIC_ORIGIN=
# Only needed for a legacy global operator / database-wide backup account.
ADMIN_EMAIL=commissioner@example.com
ADMIN_BOOTSTRAP_KEY=REPLACE_WITH_RANDOM_SECRET_32_PLUS_CHARS
# Generate with: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
# Optional offsite encrypted snapshot target (rclone must be configured and installed).
BACKUP_RCLONE_REMOTE=
AUTO_SYNC_ON_STARTUP=true

# HTTPS application root used for invitation, verification and standings email links.
# Use http://localhost:5173 for local Vite development only.
APP_PUBLIC_URL=http://localhost:5173
# Optional automated email. 'none' disables delivery; choose 'gmail', 'brevo', or 'resend'.
MAIL_PROVIDER=none
# For Gmail, this MUST be the Gmail account that authorized the OAuth refresh token.
# For Brevo/Resend, use a verified sender/domain approved by that provider.
MAIL_FROM=your-operator@gmail.com
# Required whenever MAIL_PROVIDER is not 'none'; 32-byte AES-GCM key as 64 hex characters.
# Alternatively BACKUP_ENCRYPTION_KEY is reused if MAIL_ENCRYPTION_KEY is unset.
MAIL_ENCRYPTION_KEY=
# Gmail API OAuth2 (gmail.send scope): never commit access/refresh tokens to Git.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Free transactional alternatives: use exactly one configured provider.
BREVO_API_KEY=
RESEND_API_KEY=
